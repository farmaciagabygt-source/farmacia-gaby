# Ejemplo para Raw Editor de Railway; nombrar el servicio PostgreSQL como Postgres.
GABY_SERVICE=pedidos
NODE_ENV=production
PORT=8080
DATABASE_URL=postgresql://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/gaby_pedidos?schema=public
JWT_SECRET=REEMPLAZAR_CON_CLAVE_ALEATORIA_DE_64_CARACTERES
SERVICE_API_KEY=REEMPLAZAR_CON_OTRA_CLAVE_ALEATORIA_DE_64_CARACTERES
CORS_ORIGINS=https://REEMPLAZAR-DOMINIO-VERCEL
AUTH_URL=http://${{auth.RAILWAY_PRIVATE_DOMAIN}}:8080
CATALOGO_URL=http://${{catalogo.RAILWAY_PRIVATE_DOMAIN}}:8080
INVENTARIO_URL=http://${{inventario.RAILWAY_PRIVATE_DOMAIN}}:8080
PAGOS_URL=http://${{pagos.RAILWAY_PRIVATE_DOMAIN}}:8080
