# Ejemplo para Raw Editor de Railway; nombrar el servicio PostgreSQL como Postgres.
GABY_SERVICE=auth
NODE_ENV=production
PORT=8080
DATABASE_URL=postgresql://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/gaby_auth?schema=public
JWT_SECRET=REEMPLAZAR_CON_CLAVE_ALEATORIA_DE_64_CARACTERES
SERVICE_API_KEY=REEMPLAZAR_CON_OTRA_CLAVE_ALEATORIA_DE_64_CARACTERES
CORS_ORIGINS=https://REEMPLAZAR-DOMINIO-VERCEL
JWT_EXPIRES_IN=2h
INITIAL_ADMIN_EMAIL=REEMPLAZAR_CORREO_ADMIN
INITIAL_ADMIN_PASSWORD=REEMPLAZAR_CON_CONTRASENA_SEGURA
# Opcional: EMAIL_USER y EMAIL_PASS (contraseña de aplicación Gmail) para recuperación.
